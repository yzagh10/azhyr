local function elColors(body, order, o)
	o = o or {}
	local colors = o.Colors or {}
	local row = rowBase(body, order, 44, false)
	rowTitle(row, o.Name or "Cor", 215)

	local strip = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, math.max(#colors * 27 - 7, 0), 0, 22),
		BackgroundTransparency = 1, Parent = row,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 7),
		VerticalAlignment = Enum.VerticalAlignment.Center, Parent = strip,
	})

	local sw = {}

	local function select(color, silent)
		for _, s in ipairs(sw) do
			tw(s.Ring, 0.16, { Transparency = (s.Color == color) and 0 or 1 })
		end
		setAccent(color)
		if not silent and o.Callback then task.spawn(o.Callback, color) end
	end

	for _, color in ipairs(colors) do
		local b = new("TextButton", {
			Size = UDim2.new(0, 20, 0, 20), BackgroundColor3 = color,
			Text = "", AutoButtonColor = false, Parent = strip,
		})
		corner(b, 10)
		local ring = stroke(b, Theme.White, 2, 1)
		b.MouseEnter:Connect(function() tw(b, 0.16, { Size = UDim2.new(0, 24, 0, 24) }, Enum.EasingStyle.Back) end)
		b.MouseLeave:Connect(function() tw(b, 0.16, { Size = UDim2.new(0, 20, 0, 20) }) end)
		b.Activated:Connect(function() select(color) end)
		table.insert(sw, { Color = color, Ring = ring })
	end

	return { Select = function(c) select(c, true) end }
end

