local function rowBase(body, order, h, clickable)
	local class = clickable and "TextButton" or "Frame"
	local row = new(class, {
		Size = UDim2.new(1, 0, 0, h or 40), BackgroundColor3 = Theme.Elem,
		LayoutOrder = order, Parent = body,
	})
	if clickable then
		row.Text = ""
		row.AutoButtonColor = false
	end
	corner(row, 9)
	stroke(row, Theme.Stroke, 1, 0.55)
	if clickable then
		row.MouseEnter:Connect(function() tw(row, 0.18, { BackgroundColor3 = Theme.Hover }) end)
		row.MouseLeave:Connect(function() tw(row, 0.18, { BackgroundColor3 = Theme.Elem }) end)
	end
	return row
end

local function rowTitle(row, text, reserve)
	return new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(1, -(reserve or 90), 1, 0), Font = Enum.Font.GothamMedium,
		Text = text, TextColor3 = Theme.Text, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
end

local function elToggle(body, order, o)
	o = o or {}
	local on = o.Default == true
	local row = rowBase(body, order, 40, true)
	rowTitle(row, o.Name or "Toggle", 76)

	local pill = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 40, 0, 22), BackgroundColor3 = Theme.Hover, Parent = row,
	})
	corner(pill, 11)
	local glow = stroke(pill, Theme.Accent, 1, 1)
	onAccent(function(c) glow.Color = c end)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.new(0, 16, 0, 16), BackgroundColor3 = Theme.White, Parent = pill,
	})
	corner(knob, 8)

	local function render(anim)
		local goal = UDim2.new(0, on and 21 or 3, 0.5, 0)
		local col = on and Theme.Accent or Theme.Hover
		if anim then
			tw(knob, 0.3, { Position = goal }, Enum.EasingStyle.Back)
			tw(pill, 0.22, { BackgroundColor3 = col })
			tw(glow, 0.22, { Transparency = on and 0 or 1 })
		else
			knob.Position = goal
			pill.BackgroundColor3 = col
			glow.Transparency = on and 0 or 1
		end
	end

	onAccent(function(c) if on then pill.BackgroundColor3 = c end end)

	local function set(v, silent)
		on = v == true
		render(true)
		if not silent and o.Callback then task.spawn(o.Callback, on) end
	end

	row.Activated:Connect(function() set(not on) end)
	render(false)
	return { Set = set, Get = function() return on end }
end

local function elSlider(body, order, o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local step = o.Step or 1
	local val = math.clamp(o.Default or min, min, max)

	local row = rowBase(body, order, 40, false)
	rowTitle(row, o.Name or "Slider", 200)

	local valLabel = new("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -152, 0.5, 0), Size = UDim2.new(0, 56, 0, 40),
		Font = Enum.Font.GothamBold, Text = "", TextColor3 = Theme.Dim,
		TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
	})

	local track = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 126, 0, 5), BackgroundColor3 = Theme.Bg, Parent = row,
	})
	corner(track, 3)

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0, Parent = track,
	})
	corner(fill, 3)
	onAccent(function(c) fill.BackgroundColor3 = c end)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 13, 0, 13), BackgroundColor3 = Theme.White, Parent = track,
	})
	corner(knob, 7)
	local ring = stroke(knob, Theme.Accent, 2, 0)
	onAccent(function(c) ring.Color = c end)

	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, Parent = row,
	})

	local function fmt(v)
		if step >= 1 then return tostring(math.floor(v + 0.5)) .. (o.Suffix or "") end
		return string.format("%.2f", v) .. (o.Suffix or "")
	end

	local function set(v, silent)
		val = math.clamp(v, min, max)
		local a = (val - min) / math.max(max - min, 1e-6)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valLabel.Text = fmt(val)
		if not silent and o.Callback then task.spawn(o.Callback, val) end
	end

	local dragging = false
	local function fromX(x)
		local rel = (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		rel = math.clamp(rel, 0, 1)
		local raw = min + (max - min) * rel
		if step > 0 then raw = math.floor(raw / step + 0.5) * step end
		set(raw)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tw(knob, 0.16, { Size = UDim2.new(0, 17, 0, 17) }, Enum.EasingStyle.Back)
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				tw(knob, 0.16, { Size = UDim2.new(0, 13, 0, 13) }, Enum.EasingStyle.Back)
			end
		end
	end)

	set(val, true)
	return { Set = function(v) set(v) end, Get = function() return val end }
end

local function elDropdown(body, order, o)
	o = o or {}
	local items = o.Options or {}
	local sel = o.Default or items[1]
	local open = false
	local listH = #items * 28 + 8

	local box = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1,
		ClipsDescendants = true, LayoutOrder = order, Parent = body,
	})

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.Elem,
		Text = "", AutoButtonColor = false, Parent = box,
	})
	corner(head, 9)
	stroke(head, Theme.Stroke, 1, 0.55)
	rowTitle(head, o.Name or "Dropdown", 190)

	local valLabel = new("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -38, 0.5, 0), Size = UDim2.new(0, 150, 0, 40),
		Font = Enum.Font.GothamBold, Text = "", TextColor3 = Theme.Dim,
		TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Parent = head,
	})
	local chev = new("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.new(0, 14, 0, 14),
		Font = Enum.Font.GothamBold, Text = "v", TextColor3 = Theme.Dim,
		TextSize = 12, Parent = head,
	})

	local list = new("Frame", {
		Position = UDim2.new(0, 0, 0, 46), Size = UDim2.new(1, 0, 0, listH),
		BackgroundColor3 = Theme.Panel, Parent = box,
	})
	corner(list, 9)
	stroke(list, Theme.Stroke, 1, 0.4)
	pad(list, 4, 4, 4, 4)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	local entries = {}

	local function refresh()
		for _, e in ipairs(entries) do
			local on = e.Item == sel
			e.Btn.BackgroundTransparency = on and 0 or 1
			e.Dot.BackgroundTransparency = on and 0 or 1
			e.Lbl.TextColor3 = on and Theme.Text or Theme.Dim
		end
		valLabel.Text = tostring(sel or "-")
	end

	local function setOpen(v)
		open = v
		tw(box, 0.26, {
			Size = UDim2.new(1, 0, 0, open and (46 + listH) or 40),
		}, Enum.EasingStyle.Quint)
		tw(chev, 0.26, { Rotation = open and 180 or 0 })
	end

	for i, item in ipairs(items) do
		local opt = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Theme.Hover,
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			LayoutOrder = i, Parent = list,
		})
		corner(opt, 6)
		local dotMark = new("Frame", {
			Size = UDim2.new(0, 4, 0, 4), Position = UDim2.new(0, 10, 0.5, -2),
			BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, Parent = opt,
		})
		corner(dotMark, 2)
		onAccent(function(c) dotMark.BackgroundColor3 = c end)

		local lbl = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 20, 0, 0),
			Size = UDim2.new(1, -26, 1, 0), Font = Enum.Font.Gotham,
			Text = tostring(item), TextColor3 = Theme.Dim, TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left, Parent = opt,
		})

		opt.MouseEnter:Connect(function()
			if item ~= sel then opt.BackgroundTransparency = 0.5 end
		end)
		opt.MouseLeave:Connect(function()
			if item ~= sel then opt.BackgroundTransparency = 1 end
		end)
		opt.Activated:Connect(function()
			sel = item
			refresh()
			setOpen(false)
			if o.Callback then task.spawn(o.Callback, item) end
		end)
		table.insert(entries, { Item = item, Btn = opt, Dot = dotMark, Lbl = lbl })
	end

	head.Activated:Connect(function() setOpen(not open) end)
	head.MouseEnter:Connect(function() tw(head, 0.18, { BackgroundColor3 = Theme.Hover }) end)
	head.MouseLeave:Connect(function() tw(head, 0.18, { BackgroundColor3 = Theme.Elem }) end)

	refresh()
	return { Get = function() return sel end, Set = function(v) sel = v; refresh() end }
end

local function elKeybind(body, order, o)
	o = o or {}
	local key = o.Default or Enum.KeyCode.Unknown
	local listening, conn = false, nil

	local row = rowBase(body, order, 40, true)
	rowTitle(row, o.Name or "Keybind", 130)

	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 96, 0, 26), BackgroundColor3 = Theme.Hover,
		Text = "", AutoButtonColor = false, Parent = row,
	})
	corner(btn, 7)
	local lbl = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
		Font = Enum.Font.GothamBold, Text = "", TextColor3 = Theme.Text,
		TextSize = 11, Parent = btn,
	})

	local function render()
		lbl.Text = (key == Enum.KeyCode.Unknown) and "-" or key.Name
	end

	local function stop()
		listening = false
		if conn then conn:Disconnect(); conn = nil end
		lbl.TextColor3 = Theme.Text
		tw(btn, 0.18, { BackgroundColor3 = Theme.Hover })
		render()
	end

	local function listen()
		if listening then stop() return end
		listening = true
		lbl.Text = "..."
		lbl.TextColor3 = Theme.Accent
		tw(btn, 0.18, { BackgroundColor3 = Theme.Elem })
		conn = UserInputService.InputBegan:Connect(function(input, processed)
			if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if input.KeyCode == Enum.KeyCode.Escape then stop() return end
			key = input.KeyCode
			stop()
			if o.Callback then task.spawn(o.Callback, key) end
		end)
	end

	row.Activated:Connect(listen)
	btn.Activated:Connect(listen)
	render()
	return { Get = function() return key end }
end

