local function createToggle(body, order, opts)
	opts = opts or {}
	local state = opts.Default == true

	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.Element,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = order,
		Parent = body,
	})
	corner(row, 8)
	stroke(row, Theme.Stroke, 1, 0.55)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -80, 1, 0),
		Font = Enum.Font.GothamMedium,
		Text = opts.Name or "Toggle",
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local pill = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 36, 0, 20),
		BackgroundColor3 = Theme.ElementHover,
		Parent = row,
	})
	corner(pill, 10)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.new(0, 14, 0, 14),
		BackgroundColor3 = Theme.White,
		Parent = pill,
	})
	corner(knob, 7)

	local function render(animated)
		local goal = UDim2.new(0, state and 19 or 3, 0.5, 0)
		local color = state and Theme.Accent or Theme.ElementHover
		if animated then
			tween(knob, 0.2, { Position = goal }, Enum.EasingStyle.Quint)
			tween(pill, 0.2, { BackgroundColor3 = color })
		else
			knob.Position = goal
			pill.BackgroundColor3 = color
		end
	end

	onAccent(function(color)
		if state then
			pill.BackgroundColor3 = color
		end
	end)

	local function set(value, silent)
		state = value == true
		render(true)
		if not silent and opts.Callback then
			task.spawn(opts.Callback, state)
		end
	end

	row.Activated:Connect(function()
		set(not state)
	end)
	row.MouseEnter:Connect(function()
		tween(row, 0.15, { BackgroundColor3 = Theme.ElementHover })
	end)
	row.MouseLeave:Connect(function()
		tween(row, 0.15, { BackgroundColor3 = Theme.Element })
	end)

	render(false)
	return { Set = set, Get = function() return state end, Row = row }
end

local function createSlider(body, order, opts)
	opts = opts or {}
	local minValue = opts.Min or 0
	local maxValue = opts.Max or 100
	local step = opts.Step or 1
	local value = math.clamp(opts.Default or minValue, minValue, maxValue)

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.Element,
		LayoutOrder = order,
		Parent = body,
	})
	corner(row, 8)
	stroke(row, Theme.Stroke, 1, 0.55)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -200, 1, 0),
		Font = Enum.Font.GothamMedium,
		Text = opts.Name or "Slider",
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local valueLabel = new("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -144, 0.5, 0),
		Size = UDim2.new(0, 52, 0, 36),
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = Theme.TextDim,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local track = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 120, 0, 6),
		BackgroundColor3 = Theme.Bg,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	corner(track, 3)

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = track,
	})
	corner(fill, 3)
	onAccent(function(color)
		fill.BackgroundColor3 = color
	end)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 12, 0, 12),
		BackgroundColor3 = Theme.White,
		ZIndex = 2,
		Parent = track,
	})
	corner(knob, 6)
	local ring = stroke(knob, Theme.Accent, 2, 0)
	onAccent(function(color)
		ring.Color = color
	end)

	local function formatValue(v)
		if step >= 1 then
			return tostring(math.floor(v + 0.5)) .. (opts.Suffix or "")
		end
		return string.format("%.2f", v) .. (opts.Suffix or "")
	end

	local function setValue(v, silent)
		value = math.clamp(v, minValue, maxValue)
		local alpha = (value - minValue) / math.max(maxValue - minValue, 1e-6)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = formatValue(value)
		if not silent and opts.Callback then
			task.spawn(opts.Callback, value)
		end
	end

	local function setFromX(x)
		local relative = (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		relative = math.clamp(relative, 0, 1)
		local raw = minValue + (maxValue - minValue) * relative
		if step > 0 then
			raw = math.floor(raw / step + 0.5) * step
		end
		setValue(raw)
	end

	local dragging = false

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	setValue(value, true)
	return { Set = function(v) setValue(v) end, Get = function() return value end }
end

local function createDropdown(body, order, opts)
	opts = opts or {}
	local items = opts.Options or {}
	local selected = opts.Default or items[1]
	local expanded = false

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = body,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = holder,
	})

	local header = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.Element,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = 1,
		Parent = holder,
	})
	corner(header, 8)
	stroke(header, Theme.Stroke, 1, 0.55)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -170, 1, 0),
		Font = Enum.Font.GothamMedium,
		Text = opts.Name or "Dropdown",
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})

	local valueLabel = new("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -34, 0.5, 0),
		Size = UDim2.new(0, 150, 0, 36),
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = Theme.TextDim,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = header,
	})

	local chevron = new("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 14, 0, 14),
		Font = Enum.Font.GothamBold,
		Text = "⌄",
		TextColor3 = Theme.TextDim,
		TextSize = 13,
		Parent = header,
	})

	local list = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Theme.Panel,
		ClipsDescendants = true,
		LayoutOrder = 2,
		Parent = holder,
	})
	corner(list, 8)
	stroke(list, Theme.Stroke, 1, 0.4)
	pad(list, 4, 4, 4, 4)
	new("UIListLayout", {
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	local entries = {}

	local function refresh()
		for _, entry in ipairs(entries) do
			local isSelected = entry.Item == selected
			entry.Button.BackgroundTransparency = isSelected and 0 or 1
			entry.Dot.BackgroundTransparency = isSelected and 0 or 1
			entry.Label.TextColor3 = isSelected and Theme.Text or Theme.TextDim
		end
		valueLabel.Text = tostring(selected or "—")
	end

	local function toggleList(open)
		if open == nil then
			expanded = not expanded
		else
			expanded = open
		end
		local target = expanded and (#items * 28 + 8) or 0
		tween(list, 0.22, { Size = UDim2.new(1, 0, 0, target) }, Enum.EasingStyle.Quint)
		tween(chevron, 0.22, { Rotation = expanded and 180 or 0 })
	end

	for index, item in ipairs(items) do
		local option = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundColor3 = Theme.ElementHover,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = index,
			Parent = list,
		})
		corner(option, 6)

		local dotMark = new("Frame", {
			Size = UDim2.new(0, 4, 0, 4),
			Position = UDim2.new(0, 10, 0.5, -2),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = 1,
			Parent = option,
		})
		corner(dotMark, 2)
		onAccent(function(color)
			dotMark.BackgroundColor3 = color
		end)

		local label = new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 20, 0, 0),
			Size = UDim2.new(1, -26, 1, 0),
			Font = Enum.Font.Gotham,
			Text = tostring(item),
			TextColor3 = Theme.TextDim,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = option,
		})

		option.MouseEnter:Connect(function()
			if item ~= selected then
				option.BackgroundTransparency = 0.5
			end
		end)
		option.MouseLeave:Connect(function()
			if item ~= selected then
				option.BackgroundTransparency = 1
			end
		end)
		option.Activated:Connect(function()
			selected = item
			refresh()
			if opts.Callback then
				task.spawn(opts.Callback, item)
			end
			toggleList(false)
		end)

		table.insert(entries, { Item = item, Button = option, Dot = dotMark, Label = label })
	end

	header.Activated:Connect(function()
		toggleList()
	end)
	header.MouseEnter:Connect(function()
		tween(header, 0.15, { BackgroundColor3 = Theme.ElementHover })
	end)
	header.MouseLeave:Connect(function()
		tween(header, 0.15, { BackgroundColor3 = Theme.Element })
	end)

	refresh()
	return {
		Get = function() return selected end,
		Set = function(item) selected = item; refresh() end,
	}
end

local function createKeybind(body, order, opts)
	opts = opts or {}
	local key = opts.Default or Enum.KeyCode.Unknown
	local listening = false
	local connection

	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.Element,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = order,
		Parent = body,
	})
	corner(row, 8)
	stroke(row, Theme.Stroke, 1, 0.55)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -120, 1, 0),
		Font = Enum.Font.GothamMedium,
		Text = opts.Name or "Keybind",
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local button = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 92, 0, 24),
		BackgroundColor3 = Theme.ElementHover,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	corner(button, 6)

	local buttonLabel = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 11,
		Parent = button,
	})

	local function render()
		if key == Enum.KeyCode.Unknown then
			buttonLabel.Text = "—"
		else
			buttonLabel.Text = key.Name
		end
	end

	local function stopListening()
		listening = false
		if connection then
			connection:Disconnect()
			connection = nil
		end
		buttonLabel.TextColor3 = Theme.Text
		button.BackgroundColor3 = Theme.ElementHover
		render()
	end

	local function startListening()
		if listening then
			stopListening()
			return
		end
		listening = true
		buttonLabel.Text = "tecla..."
		buttonLabel.TextColor3 = Theme.Accent
		button.BackgroundColor3 = Theme.Element
		connection = UserInputService.InputBegan:Connect(function(input, processed)
			if processed then
				return
			end
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			if input.KeyCode == Enum.KeyCode.Escape then
				stopListening()
				return
			end
			key = input.KeyCode
			stopListening()
			if opts.Callback then
				task.spawn(opts.Callback, key)
			end
		end)
	end

	row.Activated:Connect(startListening)
	button.Activated:Connect(startListening)
	row.MouseEnter:Connect(function()
		tween(row, 0.15, { BackgroundColor3 = Theme.ElementHover })
	end)
	row.MouseLeave:Connect(function()
		tween(row, 0.15, { BackgroundColor3 = Theme.Element })
	end)

	render()
	return { Get = function() return key end }
end

