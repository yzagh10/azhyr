local Theme = {
	Bg           = Color3.fromRGB(15, 15, 20),
	Panel        = Color3.fromRGB(23, 23, 30),
	Sidebar      = Color3.fromRGB(19, 19, 25),
	Element      = Color3.fromRGB(31, 31, 40),
	ElementHover = Color3.fromRGB(39, 39, 50),
	Accent       = Color3.fromRGB(139, 92, 246),
	Text         = Color3.fromRGB(235, 235, 244),
	TextDim      = Color3.fromRGB(136, 136, 158),
	Stroke       = Color3.fromRGB(48, 48, 61),
	Success      = Color3.fromRGB(52, 199, 123),
	Danger       = Color3.fromRGB(233, 69, 96),
	White        = Color3.fromRGB(255, 255, 255),
}

local accentHooks = {}

local function onAccent(fn)
	table.insert(accentHooks, fn)
	fn(Theme.Accent)
end

local function setAccent(color)
	Theme.Accent = color
	for _, fn in ipairs(accentHooks) do
		fn(color)
	end
end

