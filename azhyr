	Danger = Color3.fromRGB(233, 69, 96),
	Warn = Color3.fromRGB(240, 177, 60),
	White = Color3.fromRGB(255, 255, 255),
}

local hooks = {}
local function onAccent(fn)
	hooks[#hooks + 1] = fn
	fn(Theme.Accent)
end
local function setAccent(c)
	Theme.Accent = c
	for _, fn in ipairs(hooks) do fn(c) end
end

