local W_CARD, H_CARD, GAP = 304, 68, 8

local toastBox = new("Frame", {
	Name = "Toasts", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -18),
	Size = UDim2.new(0, W_CARD, 0, 460), BackgroundTransparency = 1, Parent = gui,
})

local toasts = {}

local function relayoutToasts()
	for i = 2, #toasts do
		tw(toasts[i], 0.28, {
			Position = UDim2.new(1, 0, 1, -((i - 1) * (H_CARD + GAP))),
		}, Enum.EasingStyle.Quint)
	end
end

local function notify(o)
	o = o or {}
	local color = o.Color or Theme.Accent
	local dur = o.Duration or 4

	local card = new("CanvasGroup", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 340, 1, 0),
		Size = UDim2.new(0, W_CARD, 0, H_CARD), BackgroundColor3 = Theme.Panel,
		GroupTransparency = 1, Parent = toastBox,
	})
	corner(card, 12)
	stroke(card, Theme.Stroke, 1, 0.25)

	local accent = new("Frame", {
		Size = UDim2.new(0, 3, 1, -24), Position = UDim2.new(0, 0, 0, 12),
		BackgroundColor3 = color, Parent = card,
	})
	corner(accent, 2)

	local badge = new("Frame", {
		Size = UDim2.new(0, 26, 0, 26), Position = UDim2.new(0, 16, 0, 13),
		BackgroundColor3 = color, BackgroundTransparency = 0.85, Parent = card,
	})
	corner(badge, 8)
	new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
		Font = Enum.Font.GothamBold, Text = o.Icon or "!", TextColor3 = color,
		TextSize = 13, Parent = badge,
	})

	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 52, 0, 13),
		Size = UDim2.new(1, -66, 0, 16), Font = Enum.Font.GothamBold,
		Text = o.Title or "Aviso", TextColor3 = Theme.Text, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
	})
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 52, 0, 32),
		Size = UDim2.new(1, -66, 0, 22), Font = Enum.Font.Gotham,
		Text = o.Text or "", TextColor3 = Theme.Dim, TextSize = 12, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	})

	local bar = new("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -4),
		Size = UDim2.new(1, -8, 0, 2), BackgroundColor3 = color, Parent = card,
	})
	corner(bar, 2)
	tw(bar, dur, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

	table.insert(toasts, 1, card)
	relayoutToasts()
	tw(card, 0.4, { Position = UDim2.new(1, 0, 1, 0), GroupTransparency = 0 }, Enum.EasingStyle.Back)

	task.delay(dur, function()
		if not card.Parent then return end
		tw(card, 0.24, {
			Position = UDim2.new(1, 340, 1, card.Position.Y.Offset), GroupTransparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.25)
		local i = table.find(toasts, card)
		if i then table.remove(toasts, i) end
		card:Destroy()
		relayoutToasts()
	end)
end

