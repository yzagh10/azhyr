local CARD_W, CARD_H, GAP = 300, 66, 8

local holder = new("Frame", {
	Name = "Notifications", AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -18, 1, -18), Size = UDim2.new(0, CARD_W, 0, 460),
	BackgroundTransparency = 1, Parent = gui,
})

local stack = {}

local function relayout()
	for i = 2, #stack do
		tw(stack[i], 0.28, {
			Position = UDim2.new(1, 0, 1, -((i - 1) * (CARD_H + GAP))),
		}, Enum.EasingStyle.Quint)
	end
end

local function notify(o)
	o = o or {}
	local accent = o.Color or Theme.Accent
	local dur = o.Duration or 4

	local card = new("CanvasGroup", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 340, 1, 0),
		Size = UDim2.new(0, CARD_W, 0, CARD_H), BackgroundColor3 = Theme.Panel,
		GroupTransparency = 1, Parent = holder,
	})
	corner(card, 12)
	stroke(card, Theme.Stroke, 1, 0.25)

	new("Frame", {
		Size = UDim2.new(0, 3, 1, -22), Position = UDim2.new(0, 0, 0, 11),
		BackgroundColor3 = accent, Parent = card,
	}).Parent = card

	corner(card:FindFirstChildOfClass("Frame"), 2)

	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 16, 0, 12),
		Size = UDim2.new(1, -30, 0, 16), Font = Enum.Font.GothamBold,
		Text = o.Title or "Notificação", TextColor3 = Theme.Text, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
	})

	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 16, 0, 31),
		Size = UDim2.new(1, -30, 0, 20), Font = Enum.Font.Gotham,
		Text = o.Text or "", TextColor3 = Theme.Dim, TextSize = 12, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	})

	local bar = new("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -4),
		Size = UDim2.new(1, -8, 0, 2), BackgroundColor3 = accent, Parent = card,
	})
	corner(bar, 2)
	tw(bar, dur, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

	table.insert(stack, 1, card)
	relayout()
	tw(card, 0.4, { Position = UDim2.new(1, 0, 1, 0), GroupTransparency = 0 }, Enum.EasingStyle.Back)

	task.delay(dur, function()
		if not card.Parent then return end
		tw(card, 0.25, {
			Position = UDim2.new(1, 340, 1, card.Position.Y.Offset), GroupTransparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.26)
		local i = table.find(stack, card)
		if i then table.remove(stack, i) end
		card:Destroy()
		relayout()
	end)
end

