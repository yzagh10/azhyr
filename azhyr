	hud.Size = UDim2.new(1, 0, 0, 84)
	hud.BackgroundColor3 = PANEL
	hud.BorderSizePixel = 0
	hud.TextColor3 = TEXT
	hud.TextXAlignment = Enum.TextXAlignment.Left
	hud.TextYAlignment = Enum.TextYAlignment.Top
	hud.Font = Enum.Font.Code
	hud.TextSize = 13
	hud.Text = ""
	hud.Parent = window

	local status = Instance.new("TextLabel")
	status.AnchorPoint = Vector2.new(0, 1)
	status.Position = UDim2.new(0, 0, 1, 0)
	status.Size = UDim2.new(1, 0, 0, 24)
	status.BackgroundColor3 = PANEL
	status.BorderSizePixel = 0
	status.TextColor3 = TEXT
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.Font = Enum.Font.Gotham
	status.TextSize = 13
	status.Text = "  Ready"
	status.Parent = window

	local content = Instance.new("ScrollingFrame")
	content.Position = UDim2.fromOffset(0, 116)
	content.Size = UDim2.new(1, 0, 1, -144)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ScrollBarThickness = 6
	content.CanvasSize = UDim2.new()
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.Parent = window

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = content

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 14)
	padding.PaddingTop = UDim.new(0, 4)
	padding.Parent = content

	local nextOrder = 0
	local function order(): number
		nextOrder += 1
		return nextOrder
	end

	local function setStatus(ok: boolean, message: string)
		status.Text = (ok and "  OK: " or "  ERR: ") .. message
		status.TextColor3 = ok and Color3.fromRGB(130, 220, 150) or Color3.fromRGB(240, 130, 130)
	end

	local function makeButton(parent: Instance, text: string, size: UDim2, callback: () -> ()): TextButton
		local button = Instance.new("TextButton")
		button.Size = size
		button.BackgroundColor3 = PANEL
		button.BorderSizePixel = 0
		button.TextColor3 = TEXT
		button.Font = Enum.Font.Gotham
		button.TextSize = 13
		button.Text = text
		button.AutoButtonColor = true
		button.Parent = parent
		button.Activated:Connect(callback)
		return button
	end

	local function makeRow(): Frame
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 28)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order()
		row.Parent = content
		return row
	end

	local function makeToggle(text: string, onChange: (boolean) -> boolean): TextButton
		local row = makeRow()
		local value = false
		local button: TextButton
		local function refresh()
			button.Text = text .. ": " .. (value and "ON" or "OFF")
			button.BackgroundColor3 = value and ON or PANEL
		end
		button = makeButton(row, "", UDim2.fromScale(1, 1), function()
			-- onChange returns the value that actually took effect (false if the server refused)
			value = onChange(not value)
			refresh()
		end)
		refresh()
		return button
	end

	local function makeInputRow(label: string, placeholder: string, buttonText: string, onSubmit: (string) -> ()): TextBox
		local row = makeRow()
		local labelFrame = Instance.new("TextLabel")
		labelFrame.Size = UDim2.new(0, 70, 1, 0)
		labelFrame.BackgroundTransparency = 1
		labelFrame.TextColor3 = TEXT
		labelFrame.TextXAlignment = Enum.TextXAlignment.Left
		labelFrame.Font = Enum.Font.Gotham
		labelFrame.TextSize = 13
		labelFrame.Text = label
		labelFrame.Parent = row

		local box = Instance.new("TextBox")
		box.Position = UDim2.fromOffset(72, 0)
		box.Size = UDim2.new(1, -72 - 64, 1, 0)
		box.BackgroundColor3 = PANEL
		box.BorderSizePixel = 0
		box.TextColor3 = TEXT
		box.PlaceholderText = placeholder
		box.PlaceholderColor3 = Color3.fromRGB(130, 135, 148)
		box.ClearTextOnFocus = false
		box.Font = Enum.Font.Code
		box.TextSize = 13
		box.Text = ""
		box.Parent = row

		makeButton(row, buttonText, UDim2.new(0, 60, 1, 0), function()
			onSubmit(box.Text)
		end).Position = UDim2.new(1, -60, 0, 0)
		box.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				onSubmit(box.Text)
			end
		end)
		return box
	end

	-- Dragging by the title bar
	do
		local dragStart: Vector3? = nil
		local windowStart = window.Position
		titleBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragStart = input.Position
				windowStart = window.Position
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragStart and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - dragStart
				window.Position = UDim2.fromOffset(windowStart.X.Offset + delta.X, windowStart.Y.Offset + delta.Y)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragStart = nil
			end
		end)
	end

	------------------------------------------------------------ local movement tools

	local function getRoot(): BasePart?
		local character = localPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			return root
		end
		return nil
	end

	local noclipConnection: RBXScriptConnection? = nil
	local function setNoclip(enabled: boolean)
		if noclipConnection then
			noclipConnection:Disconnect()
			noclipConnection = nil
		end
		if not enabled then
			return
		end
		noclipConnection = RunService.Stepped:Connect(function()
			local character = localPlayer.Character
			if not character then
				return
			end
			for _, descendant in character:GetDescendants() do
				if descendant:IsA("BasePart") then
					descendant.CanCollide = false
				end
			end
		end)
	end

	local flyConnection: RBXScriptConnection? = nil
	local function setFly(enabled: boolean)
		if flyConnection then
			flyConnection:Disconnect()
			flyConnection = nil
		end
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not enabled then
			if humanoid then
				humanoid.PlatformStand = false
			end
			local root = getRoot()
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
			end
			return
		end
		if humanoid then
			humanoid.PlatformStand = true
		end
		flyConnection = RunService.RenderStepped:Connect(function()
			local root = getRoot()
			local camera = Workspace.CurrentCamera
			if not root or not camera then
				return
			end
			local direction = Vector3.zero
			if UserInputService:GetFocusedTextBox() == nil then
				local look = camera.CFrame.LookVector
				local right = camera.CFrame.RightVector
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += look end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= look end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += right end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= right end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction -= Vector3.yAxis end
			end
			if direction.Magnitude > 0 then
				direction = direction.Unit * Config.FlySpeed
			end
			root.AssemblyLinearVelocity = direction
		end)
	end

	------------------------------------------------------------------ menu contents

	makeToggle("God mode", function(want)
		local ok, message = call("god", want)
		setStatus(ok, message)
		if ok then
			return want
		end
		return not want
	end)

	makeToggle("Noclip (local)", function(want)
		setNoclip(want)
		setStatus(true, want and "Noclip ON (you fall through floors unless Fly is on)" or "Noclip OFF")
		return want
	end)

	makeToggle("Fly (WASD, Space/Ctrl)", function(want)
		setFly(want)
		setStatus(true, want and "Fly ON" or "Fly OFF")
		return want
	end)

	makeInputRow("WalkSpeed", "e.g. 50", "Set", function(text)
		local value = tonumber(text)
		if value == nil then
			setStatus(false, "Enter a number")
			return
		end
		setStatus(call("speed", value))
	end)

	makeInputRow("JumpPower", "e.g. 100", "Set", function(text)
		local value = tonumber(text)
		if value == nil then
			setStatus(false, "Enter a number")
			return
		end
		setStatus(call("jump", value))
	end)

	do
		local row = makeRow()
		makeButton(row, "Reset speed / jump", UDim2.fromScale(1, 1), function()
			setStatus(call("resetMovement"))
		end)
	end

	local coordsBox: TextBox
	coordsBox = makeInputRow("Teleport", "x y z", "Go", function(text)
		local vec = Util.parseVec3(text)
		if not vec then
			setStatus(false, "Expected three numbers: x y z")
			return
		end
		setStatus(call("teleport", vec))
	end)

	do
		local row = makeRow()
		makeButton(row, "Fill with my current position", UDim2.fromScale(1, 1), function()
			local root = getRoot()
			if not root then
				setStatus(false, "No character")
				return
			end
			local p = root.Position
			coordsBox.Text = Util.formatVec3(p.X, p.Y, p.Z)
			setStatus(true, "Position copied into the box")
		end)
	end

	makeInputRow("To player", "name or prefix", "Go", function(text)
		setStatus(call("teleportToPlayer", Util.trim(text)))
	end)

	local waypointHeader = Instance.new("TextLabel")
	waypointHeader.Size = UDim2.new(1, 0, 0, 20)
	waypointHeader.BackgroundTransparency = 1
	waypointHeader.TextColor3 = TEXT
	waypointHeader.TextXAlignment = Enum.TextXAlignment.Left
	waypointHeader.Font = Enum.Font.GothamBold
	waypointHeader.TextSize = 13
	waypointHeader.Text = "Waypoints (" .. Config.WaypointFolderName .. ")"
	waypointHeader.LayoutOrder = order()
	waypointHeader.Parent = content

	local waypointList = Instance.new("Frame")
	waypointList.Size = UDim2.new(1, 0, 0, 0)
	waypointList.AutomaticSize = Enum.AutomaticSize.Y
	waypointList.BackgroundTransparency = 1
	waypointList.LayoutOrder = order()
	waypointList.Parent = content
	local waypointLayout = Instance.new("UIListLayout")
	waypointLayout.Padding = UDim.new(0, 4)
	waypointLayout.Parent = waypointList

	local function refreshWaypoints()
		for _, child in waypointList:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local ok, message, names = call("listWaypoints")
		setStatus(ok, message)
		if ok and type(names) == "table" then
			for _, name in names do
				if type(name) == "string" then
					makeButton(waypointList, name, UDim2.new(1, 0, 0, 26), function()
						setStatus(call("teleportToWaypoint", name))
					end)
				end
			end
		end
	end

	do
		local row = makeRow()
		makeButton(row, "Refresh waypoint list", UDim2.fromScale(1, 1), refreshWaypoints)
	end

	------------------------------------------------------------------- HUD + toggle

	local elapsed = 0
	local frames = 0
	RunService.RenderStepped:Connect(function(dt)
		if not gui.Enabled then
			return
		end
		elapsed += dt
		frames += 1
		if elapsed < 0.25 then
			return
		end
		local fps = frames / elapsed
		elapsed, frames = 0, 0

		local pingOk, ping = pcall(function()
			return (Stats :: any).Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		local lines = { string.format("FPS %.0f   Ping %s", fps, pingOk and string.format("%.0f ms", ping) or "n/a") }
		local root = getRoot()
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root then
			local p = root.Position
			table.insert(lines, "Pos   " .. Util.formatVec3(p.X, p.Y, p.Z))
			table.insert(lines, string.format("Speed %.1f studs/s", root.AssemblyLinearVelocity.Magnitude))
		end
		if humanoid then
			table.insert(lines, string.format("HP %.0f/%.0f  WS %.0f  JP %.0f", humanoid.Health, humanoid.MaxHealth, humanoid.WalkSpeed, humanoid.JumpPower))
			table.insert(lines, "State " .. humanoid:GetState().Name)
		end
		hud.Text = table.concat(lines, "\n")
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Config.ToggleKey then
			gui.Enabled = not gui.Enabled
			if gui.Enabled then
				refreshWaypoints()
			end
		end
	end)

	-- Fly is tied to the Humanoid's PlatformStand, so re-apply it on the new character after a respawn.
	localPlayer.CharacterAdded:Connect(function(character)
		if flyConnection then
			character:WaitForChild("Humanoid", 10)
			setFly(true)
		end
	end)
end

if RunService:IsServer() then
	runServer()
else
	runClient()
end
