local function createColors(body, order, o)
	o = o or {}
	local colors = o.Colors or {}
	local row = shell(body, order, 42, false)
	caption(row, o.Name or "Cor", 210)

	local strip = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, math.max(#colors * 26 - 6, 0), 0, 20),
		BackgroundTransparency = 1, Parent = row,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
		VerticalAlignment = Enum.VerticalAlignment.Center, Parent = strip,
	})

	local swatches = {}

	local function select(color, silent)
		for _, s in ipairs(swatches) do
			tw(s.Ring, 0.15, { Transparency = (s.Color == color) and 0 or 1 })
		end
		setAccent(color)
		if not silent and o.Callback then task.spawn(o.Callback, color) end
	end

	for _, color in ipairs(colors) do
		local b = new("TextButton", {
			Size = UDim2.new(0, 20, 0, 20), BackgroundColor3 = color,
			Text = "", AutoButtonColor = false, Parent = strip,
		})
		corner(b, 10)
		local ring = stroke(b, Theme.White, 2, 1)
		b.MouseEnter:Connect(function() tw(b, 0.15, { Size = UDim2.new(0, 23, 0, 23) }, Enum.EasingStyle.Back) end)
		b.MouseLeave:Connect(function() tw(b, 0.15, { Size = UDim2.new(0, 20, 0, 20) }) end)
		b.Activated:Connect(function() select(color) end)
		table.insert(swatches, { Color = color, Ring = ring })
	end

	return { Select = function(c) select(c, true) end }
end

