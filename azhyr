local function createWindow(config)
	config = config or {}
	local fullSize = config.Size or UDim2.new(0, 660, 0, 460)
	local toggleKey = config.ToggleKey or Enum.KeyCode.RightShift

	local shadow = new("Frame", {
		Name = "Shadow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 8),
		Size = UDim2.new(0, fullSize.X.Offset + 8, 0, fullSize.Y.Offset + 8),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = gui,
	})
	corner(shadow, 18)

	local root = new("CanvasGroup", {
		Name = "Root",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = fullSize,
		BackgroundColor3 = Theme.Bg,
		ClipsDescendants = true,
		GroupTransparency = 1,
		ZIndex = 1,
		Parent = gui,
	})
	corner(root, 14)
	stroke(root, Theme.Stroke, 1, 0.35)

	local topbar = new("Frame", {
		Name = "Topbar",
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = 3,
		Parent = root,
	})

	local dot = new("Frame", {
		Size = UDim2.new(0, 9, 0, 9),
		Position = UDim2.new(0, 18, 0, 14),
		BackgroundColor3 = Theme.Accent,
		Parent = topbar,
	})
	corner(dot, 5)
	onAccent(function(color)
		dot.BackgroundColor3 = color
	end)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 34, 0, 7),
		Size = UDim2.new(0, 320, 0, 18),
		Font = Enum.Font.GothamBold,
		Text = config.Title or "Interface",
		TextColor3 = Theme.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = topbar,
	})

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 34, 0, 25),
		Size = UDim2.new(0, 320, 0, 14),
		Font = Enum.Font.Gotham,
		Text = config.Subtitle or "v1.0.0",
		TextColor3 = Theme.TextDim,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = topbar,
	})

	local function topButton(glyph, xOffset, hoverColor)
		local btn = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, xOffset, 0, 8),
			Size = UDim2.new(0, 30, 0, 30),
			BackgroundColor3 = Theme.Element,
			BackgroundTransparency = 1,
			Text = glyph,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextColor3 = Theme.TextDim,
			AutoButtonColor = false,
			ZIndex = 4,
			Parent = topbar,
		})
		corner(btn, 8)
		btn.MouseEnter:Connect(function()
			tween(btn, 0.15, {
				BackgroundColor3 = hoverColor or Theme.Element,
				BackgroundTransparency = 0,
				TextColor3 = Theme.White,
			})
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, 0.15, {
				BackgroundTransparency = 1,
				TextColor3 = Theme.TextDim,
			})
		end)
		return btn
	end

	local closeBtn = topButton("✕", -12, Theme.Danger)
	local minBtn = topButton("—", -48, Theme.Element)

	local sidebar = new("Frame", {
		Name = "Sidebar",
		Position = UDim2.new(0, 10, 0, 46),
		Size = UDim2.new(0, 158, 1, -56),
		BackgroundColor3 = Theme.Sidebar,
		ZIndex = 2,
		Parent = root,
	})
	corner(sidebar, 10)

	local tabList = new("Frame", {
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.new(0, 6, 0, 6),
		BackgroundTransparency = 1,
		Parent = sidebar,
	})
	new("UIListLayout", {
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = tabList,
	})

	local content = new("Frame", {
		Name = "Content",
		Position = UDim2.new(0, 178, 0, 46),
		Size = UDim2.new(1, -188, 1, -56),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = root,
	})

	local win = {
		Tabs = {},
		CurrentTab = nil,
		Open = true,
		Root = root,
	}

	local previousPage = nil

	local function selectTab(tab)
		if win.CurrentTab == tab then
			return
		end
		for _, other in ipairs(win.Tabs) do
			other:SetSelected(false)
		end
		win.CurrentTab = tab
		tab:SetSelected(true)

		if previousPage and previousPage ~= tab.Page then
			previousPage.Visible = false
		end
		previousPage = tab.Page

		tab.Page.Visible = true
		tab.Page.GroupTransparency = 1
		tab.Page.Position = UDim2.new(0, 12, 0, 0)
		tween(tab.Page, 0.28, {
			GroupTransparency = 0,
			Position = UDim2.new(0, 0, 0, 0),
		}, Enum.EasingStyle.Quint)
	end

	function win:CreateTab(tabConfig)
		tabConfig = tabConfig or {}
		local order = #self.Tabs + 1

		local page = new("CanvasGroup", {
			Name = "Page_" .. order,
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = content,
		})

		local scroll = new("ScrollingFrame", {
			Name = "Scroll",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Accent,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = page,
		})
		new("UIListLayout", {
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = scroll,
		})
		pad(scroll, 0, 6, 10, 0)
		onAccent(function(color)
			scroll.ScrollBarImageColor3 = color
		end)

		local button = new("TextButton", {
			Name = "Tab_" .. order,
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundColor3 = Theme.Element,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = tabList,
		})
		corner(button, 8)

		local bar = new("Frame", {
			Size = UDim2.new(0, 3, 0, 16),
			Position = UDim2.new(0, 0, 0.5, -8),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = 1,
			Parent = button,
		})
		corner(bar, 2)
		onAccent(function(color)
			bar.BackgroundColor3 = color
		end)

		local icon = new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 14, 0, 0),
			Size = UDim2.new(0, 18, 1, 0),
			Font = Enum.Font.GothamBold,
			Text = tabConfig.Icon or "•",
			TextColor3 = Theme.TextDim,
			TextSize = 13,
			Parent = button,
		})

		local label = new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 34, 0, 0),
			Size = UDim2.new(1, -40, 1, 0),
			Font = Enum.Font.GothamMedium,
			Text = tabConfig.Title or ("Tab " .. order),
			TextColor3 = Theme.TextDim,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = button,
		})

		local tab = { Page = page, Button = button }

		function tab:SetSelected(state)
			if state then
				button.BackgroundTransparency = 0
				bar.BackgroundTransparency = 0
				label.TextColor3 = Theme.Text
				icon.TextColor3 = Theme.Accent
			else
				button.BackgroundTransparency = 1
				bar.BackgroundTransparency = 1
				label.TextColor3 = Theme.TextDim
				icon.TextColor3 = Theme.TextDim
			end
		end

		onAccent(function(color)
			if win.CurrentTab == tab then
				icon.TextColor3 = color
			end
		end)

		button.MouseEnter:Connect(function()
			if win.CurrentTab ~= tab then
				button.BackgroundTransparency = 0.5
			end
		end)
		button.MouseLeave:Connect(function()
			if win.CurrentTab ~= tab then
				button.BackgroundTransparency = 1
			end
		end)
		button.Activated:Connect(function()
			selectTab(tab)
		end)

		local sectionCount = 0

		function tab:CreateSection(sectionTitle)
			sectionCount = sectionCount + 1

			local holder = new("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				LayoutOrder = sectionCount,
				Parent = scroll,
			})
			new("UIListLayout", {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = holder,
			})

			local head = new("Frame", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				LayoutOrder = 1,
				Parent = holder,
			})

			local tick = new("Frame", {
				Size = UDim2.new(0, 3, 0, 11),
				Position = UDim2.new(0, 0, 0.5, -5),
				BackgroundColor3 = Theme.Accent,
				Parent = head,
			})
			corner(tick, 2)
			onAccent(function(color)
				tick.BackgroundColor3 = color
			end)

			new("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 10, 0, 0),
				Size = UDim2.new(1, -10, 1, 0),
				Font = Enum.Font.GothamBold,
				Text = string.upper(sectionTitle or "Section"),
				TextColor3 = Theme.TextDim,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = head,
			})

			local body = new("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				LayoutOrder = 2,
				Parent = holder,
			})
			new("UIListLayout", {
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = body,
			})

			local rowOrder = 0
			local function nextOrder()
				rowOrder = rowOrder + 1
				return rowOrder
			end

			local section = {}

			function section:CreateToggle(opts)
				return createToggle(body, nextOrder(), opts)
			end
			function section:CreateSlider(opts)
				return createSlider(body, nextOrder(), opts)
			end
			function section:CreateDropdown(opts)
				return createDropdown(body, nextOrder(), opts)
			end
			function section:CreateKeybind(opts)
				return createKeybind(body, nextOrder(), opts)
			end
			function section:CreateTextbox(opts)
				return createTextbox(body, nextOrder(), opts)
			end
			function section:CreateButton(opts)
				return createButton(body, nextOrder(), opts)
			end
			function section:CreateLabel(opts)
				return createLabel(body, nextOrder(), opts)
			end
			function section:CreateColors(opts)
				return createColors(body, nextOrder(), opts)
			end

			return section
		end

		table.insert(self.Tabs, tab)
		if #self.Tabs == 1 then
			selectTab(tab)
		end

		return tab
	end

	function win:Notify(opts)
		return notify(opts)
	end

	local minimized = false

	function win:SetOpen(state)
		if self.Open == state then
			return
		end
		self.Open = state

		if state then
			root.Visible = true
			shadow.Visible = true
			root.GroupTransparency = 1
			root.Size = UDim2.new(
				fullSize.X.Scale, fullSize.X.Offset * 0.94,
				fullSize.Y.Scale, fullSize.Y.Offset * 0.94
			)
			tween(root, 0.28, { GroupTransparency = 0, Size = fullSize }, Enum.EasingStyle.Quint)
			shadow.BackgroundTransparency = 1
			tween(shadow, 0.28, { BackgroundTransparency = 0.55 })
		else
			tween(root, 0.2, {
				GroupTransparency = 1,
				Size = UDim2.new(
					fullSize.X.Scale, fullSize.X.Offset * 0.94,
					fullSize.Y.Scale, fullSize.Y.Offset * 0.94
				),
			})
			tween(shadow, 0.2, { BackgroundTransparency = 1 })
			task.delay(0.22, function()
				if not self.Open then
					root.Visible = false
					shadow.Visible = false
				end
			end)
		end
	end

	function win:Toggle()
		self:SetOpen(not self.Open)
	end

	function win:SetMinimized(state)
		if minimized == state then
			return
		end
		minimized = state

		if state then
			sidebar.Visible = false
			content.Visible = false
			tween(root, 0.25, { Size = UDim2.new(0, 340, 0, 46) }, Enum.EasingStyle.Quint)
			tween(shadow, 0.25, { Size = UDim2.new(0, 348, 0, 54) }, Enum.EasingStyle.Quint)
		else
			tween(root, 0.25, { Size = fullSize }, Enum.EasingStyle.Quint)
			tween(shadow, 0.25, {
				Size = UDim2.new(0, fullSize.X.Offset + 8, 0, fullSize.Y.Offset + 8),
			}, Enum.EasingStyle.Quint)
			task.delay(0.08, function()
				if not minimized then
					sidebar.Visible = true
					content.Visible = true
				end
			end)
		end
	end

	-- arraste
	local dragging = false
	local dragStart, startPos

	topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = root.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			root.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
			shadow.Position = UDim2.new(
				root.Position.X.Scale, root.Position.X.Offset,
				root.Position.Y.Scale, root.Position.Y.Offset + 8
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == toggleKey then
			win:Toggle()
		end
	end)

	closeBtn.Activated:Connect(function()
		win:SetOpen(false)
	end)
	minBtn.Activated:Connect(function()
		win:SetMinimized(not minimized)
	end)

	shadow.BackgroundTransparency = 0.55
	tween(root, 0.35, { GroupTransparency = 0 }, Enum.EasingStyle.Quint)

	return win
end

