local function new(class, props)
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				pcall(function() inst[k] = v end)
			end
		end
		if props.Parent then inst.Parent = props.Parent end
	end
	return inst
end

local function tw(inst, dur, props, style, dir)
	local t = TweenService:Create(inst, TweenInfo.new(
		dur or 0.22, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out
	), props)
	t:Play()
	return t
end

local function corner(p, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 9), Parent = p }) end
local function stroke(p, c, t, a)
	return new("UIStroke", {
		Color = c or Theme.Stroke, Thickness = t or 1,
		Transparency = a or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p,
	})
end
local function pad(p, t, r, b, l)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, t or 0), PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0), PaddingLeft = UDim.new(0, l or 0), Parent = p,
	})
end

