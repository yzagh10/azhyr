	corner(row, 8)
	stroke(row, Theme.Stroke, 1, 0.55)

	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Font = Enum.Font.GothamBold,
		Text = opts.Name or "Button",
		TextColor3 = Theme.Text,
		TextSize = 12,
		Parent = row,
	})

	row.MouseEnter:Connect(function()
		tween(row, 0.15, { BackgroundColor3 = Theme.Accent })
		tween(label, 0.15, { TextColor3 = Theme.White })
	end)
	row.MouseLeave:Connect(function()
		tween(row, 0.15, { BackgroundColor3 = Theme.Element })
		tween(label, 0.15, { TextColor3 = Theme.Text })
	end)
	row.Activated:Connect(function()
		if opts.Callback then
			task.spawn(opts.Callback)
		end
	end)

	return row
end

local function createLabel(body, order, opts)
	opts = opts or {}
	local label = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = opts.Text or "",
		TextColor3 = Theme.TextDim,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = order,
		Parent = body,
	})
	pad(label, 2, 4, 2, 2)
	return label
end

local function createColors(body, order, opts)
	opts = opts or {}
	local colors = opts.Colors or {}

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Element,
		LayoutOrder = order,
		Parent = body,
	})
	corner(row, 8)
	stroke(row, Theme.Stroke, 1, 0.55)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -200, 1, 0),
		Font = Enum.Font.GothamMedium,
		Text = opts.Name or "Cor",
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local strip = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, math.max(#colors * 26 - 6, 0), 0, 20),
		BackgroundTransparency = 1,
		Parent = row,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = strip,
	})

	local swatches = {}

	local function select(color, silent)
		for _, swatch in ipairs(swatches) do
			swatch.Ring.Transparency = (swatch.Color == color) and 0 or 1
		end
		setAccent(color)
		if not silent and opts.Callback then
			task.spawn(opts.Callback, color)
		end
	end

	for _, color in ipairs(colors) do
		local button = new("TextButton", {
			Size = UDim2.new(0, 20, 0, 20),
			BackgroundColor3 = color,
			Text = "",
			AutoButtonColor = false,
			Parent = strip,
		})
		corner(button, 10)
		local ring = stroke(button, Theme.White, 2, 1)
		button.Activated:Connect(function()
			select(color)
		end)
		table.insert(swatches, { Button = button, Ring = ring, Color = color })
	end

	return { Select = function(color) select(color, true) end }
end

