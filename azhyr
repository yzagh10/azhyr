		Position = UDim2.new(1, -4, 0, 0), Size = UDim2.new(0, 160, 1, 0),
		Font = Enum.Font.GothamBold, Text = "AURORA", TextColor3 = Theme.Dim,
		TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, Parent = footer,
	})

	local win = { Tabs = {}, Current = nil, Open = true, Root = root, Minimized = false }
	local prevPage = nil

	local function selectTab(tab)
		if win.Current == tab then return end
		for _, t in ipairs(win.Tabs) do t:SetSelected(false) end
		win.Current = tab
		tab:SetSelected(true)
		if prevPage and prevPage ~= tab.Page then prevPage.Visible = false end
		prevPage = tab.Page
		tab.Page.Visible = true
		tab.Page.GroupTransparency = 1
		tab.Page.Position = UDim2.new(0, 14, 0, 0)
		tw(tab.Page, 0.3, {
			GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0),
		}, Enum.EasingStyle.Quint)
	end

	function win:CreateTab(tabCfg)
		tabCfg = tabCfg or {}
		local order = #self.Tabs + 1

		local page = new("CanvasGroup", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			Visible = false, Parent = content,
		})

		local scroll = new("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			BorderSizePixel = 0, ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Accent, CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = page,
		})
		new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
		pad(scroll, 0, 6, 10, 0)
		onAccent(function(c) scroll.ScrollBarImageColor3 = c end)

		local btn = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Elem,
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			LayoutOrder = order, Parent = tabList,
		})
		corner(btn, 9)

		local bar = new("Frame", {
			Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 0, 0.5, -8),
			BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, Parent = btn,
		})
		corner(bar, 2)
		onAccent(function(c) bar.BackgroundColor3 = c end)

		local icon = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 15, 0, 0),
			Size = UDim2.new(0, 18, 1, 0), Font = Enum.Font.GothamBold,
			Text = tabCfg.Icon or "*", TextColor3 = Theme.Dim, TextSize = 13, Parent = btn,
		})
		local lbl = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 38, 0, 0),
			Size = UDim2.new(1, -44, 1, 0), Font = Enum.Font.GothamMedium,
			Text = tabCfg.Title or ("Tab " .. order), TextColor3 = Theme.Dim,
			TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn,
		})

		local tab = { Page = page, Button = btn }

		function tab:SetSelected(state)
			tw(btn, 0.2, { BackgroundTransparency = state and 0 or 1 })
			tw(bar, 0.2, { BackgroundTransparency = state and 0 or 1 })
			tw(lbl, 0.2, { TextColor3 = state and Theme.Text or Theme.Dim })
			icon.TextColor3 = state and Theme.Accent or Theme.Dim
		end

		onAccent(function(c)
			if win.Current == tab then icon.TextColor3 = c end
		end)

		btn.MouseEnter:Connect(function()
			if win.Current ~= tab then tw(btn, 0.18, { BackgroundTransparency = 0.55 }) end
		end)
		btn.MouseLeave:Connect(function()
			if win.Current ~= tab then tw(btn, 0.18, { BackgroundTransparency = 1 }) end
		end)
		btn.Activated:Connect(function() selectTab(tab) end)

		local secCount = 0

		function tab:CreateSection(title)
			secCount = secCount + 1

			local wrap = new("Frame", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1, LayoutOrder = secCount, Parent = scroll,
			})
			new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = wrap })

			local head = new("Frame", {
				Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
				LayoutOrder = 1, Parent = wrap,
			})
			local tick = new("Frame", {
				Size = UDim2.new(0, 3, 0, 11), Position = UDim2.new(0, 0, 0.5, -5),
				BackgroundColor3 = Theme.Accent, Parent = head,
			})
			corner(tick, 2)
			onAccent(function(c) tick.BackgroundColor3 = c end)

			new("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 0),
				Size = UDim2.new(1, -10, 1, 0), Font = Enum.Font.GothamBold,
				Text = string.upper(title or "Section"), TextColor3 = Theme.Dim,
				TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
			})

			local body = new("Frame", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1, LayoutOrder = 2, Parent = wrap,
			})
			new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })

			local n = 0
			local function ord() n = n + 1; return n end

			local s = {}
			function s:Toggle(o) return elToggle(body, ord(), o) end
			function s:Slider(o) return elSlider(body, ord(), o) end
			function s:Dropdown(o) return elDropdown(body, ord(), o) end
			function s:Keybind(o) return elKeybind(body, ord(), o) end
			function s:Textbox(o) return elTextbox(body, ord(), o) end
			function s:Button(o) return elButton(body, ord(), o) end
			function s:Label(o) return elLabel(body, ord(), o) end
			function s:Colors(o) return elColors(body, ord(), o) end
			return s
		end

		table.insert(self.Tabs, tab)
		if #self.Tabs == 1 then selectTab(tab) end
		return tab
	end

	function win:Notify(o) notify(o) end

	function win:SetOpen(state)
		if self.Open == state then return end
		self.Open = state
		if state then
			root.Visible, shadow.Visible = true, true
			root.GroupTransparency = 1
			root.Size = UDim2.new(0, full.X.Offset * 0.9, 0, full.Y.Offset * 0.9)
			tw(root, 0.36, { GroupTransparency = 0, Size = full }, Enum.EasingStyle.Back)
			shadow.BackgroundTransparency = 1
			tw(shadow, 0.36, { BackgroundTransparency = 0.55 })
		else
			tw(root, 0.22, {
				GroupTransparency = 1,
				Size = UDim2.new(0, full.X.Offset * 0.9, 0, full.Y.Offset * 0.9),
			})
			tw(shadow, 0.22, { BackgroundTransparency = 1 })
			task.delay(0.24, function()
				if not self.Open then root.Visible, shadow.Visible = false, false end
			end)
		end
	end

	function win:Toggle() self:SetOpen(not self.Open) end

	function win:SetMinimized(state)
		if self.Minimized == state then return end
		self.Minimized = state
		if state then
			tw(side, 0.18, { BackgroundTransparency = 1 })
			tw(content, 0.18, { BackgroundTransparency = 1 })
			tw(footer, 0.18, { BackgroundTransparency = 1 })
			task.delay(0.16, function()
				if self.Minimized then
					side.Visible, content.Visible, footer.Visible = false, false, false
				end
			end)
			tw(root, 0.3, { Size = UDim2.new(0, 360, 0, 52) }, Enum.EasingStyle.Quint)
			tw(shadow, 0.3, { Size = UDim2.new(0, 370, 0, 62) }, Enum.EasingStyle.Quint)
		else
			side.Visible, content.Visible, footer.Visible = true, true, true
			side.BackgroundTransparency = 0
			content.BackgroundTransparency = 1
			footer.BackgroundTransparency = 1
			tw(root, 0.32, { Size = full }, Enum.EasingStyle.Back)
			tw(shadow, 0.32, {
				Size = UDim2.new(0, full.X.Offset + 10, 0, full.Y.Offset + 10),
			}, Enum.EasingStyle.Back)
		end
	end

	local dragging, dragStart, startPos = false, nil, nil

	top.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = root.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - dragStart
			local vp = workspace.CurrentCamera.ViewportSize
			local cx = vp.X / 2 + startPos.X.Offset + d.X
			local cy = vp.Y / 2 + startPos.Y.Offset + d.Y
			cx = math.clamp(cx, 70, vp.X - 70)
			cy = math.clamp(cy, 30, vp.Y - 50)
			root.Position = UDim2.new(0.5, cx - vp.X / 2, 0.5, cy - vp.Y / 2)
			shadow.Position = UDim2.new(
				root.Position.X.Scale, root.Position.X.Offset,
				root.Position.Y.Scale, root.Position.Y.Offset + 10
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == (cfg.ToggleKey or Enum.KeyCode.RightShift) then
			win:Toggle()
		end
	end)

	closeBtn.Activated:Connect(function() win:SetOpen(false) end)
	minBtn.Activated:Connect(function() win:SetMinimized(not win.Minimized) end)

	shadow.BackgroundTransparency = 0.55
	tw(root, 0.45, { GroupTransparency = 0, Size = full }, Enum.EasingStyle.Back)

	return win
end

--=============================================================
-- FUNÇÕES DO JOGO
--=============================================================

local state = {
	Speed = 16,
	Jump = 50,
	Fly = false,
	FlySpeed = 60,
	ESP = false,
	InfJump = false,
}

local flyConn, flyBV = nil, nil
local highlights = {}

local function getChar() return LP.Character or LP.CharacterAdded:Wait() end
local function getHum()
	local c = LP.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function applyMovement()
	local h = getHum()
	if not h then return end
	h.WalkSpeed = state.Speed
	h.UseJumpPower = true
	h.JumpPower = state.Jump
end

local function stopFly()
	if flyConn then flyConn:Disconnect(); flyConn = nil end
	if flyBV then flyBV:Destroy(); flyBV = nil end
	local h = getHum()
	if h then h.PlatformStand = false end
end

local function startFly()
	stopFly()
	local c = getChar()
	local hrp = c:WaitForChild("HumanoidRootPart")
	local h = c:FindFirstChildOfClass("Humanoid")
	if h then h.PlatformStand = true end

	flyBV = new("BodyVelocity", {
		Velocity = Vector3.new(0, 0, 0),
		MaxForce = Vector3.new(1e4, 1e4, 1e4),
		Parent = hrp,
	})

	flyConn = RunService.Heartbeat:Connect(function()
		if not flyBV or not hrp.Parent then return end
		local cam = workspace.CurrentCamera
		local dir = Vector3.new(0, 0, 0)
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
		flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * state.FlySpeed or Vector3.new(0, 0, 0)
	end)
end

local function applyESP()
	for _, p in ipairs(Players:GetPlayers()) do
		local h = highlights[p]
		if state.ESP and p ~= LP and p.Character then
			if not h then
				h = Instance.new("Highlight")
				h.FillColor = Theme.Accent
				h.FillTransparency = 0.65
				h.OutlineColor = Theme.White
				h.Adornee = p.Character
				h.Parent = p.Character
				highlights[p] = h
			end
		elseif h then
			h:Destroy()
			highlights[p] = nil
		end
	end
end

local function setESPColor(color)
	for _, h in pairs(highlights) do
		h.FillColor = color
	end
end

UserInputService.JumpRequest:Connect(function()
	if not state.InfJump then return end
	local h = getHum()
	if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function()
		if state.ESP then task.wait(0.3); applyESP() end
	end)
end)

LP.CharacterAdded:Connect(function()
	stopFly()
	task.wait(0.6)
	applyMovement()
	if state.Fly then startFly() end
	if state.ESP then applyESP() end
end)

