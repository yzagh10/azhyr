local function shell(body, order, h, isButton)
	local row = new(isButton and "TextButton" or "Frame", {
		Size = UDim2.new(1, 0, 0, h or 38), BackgroundColor3 = Theme.Element,
		Text = "", AutoButtonColor = false, LayoutOrder = order, Parent = body,
	})
	corner(row, 9)
	stroke(row, Theme.Stroke, 1, 0.55)
	if isButton then
		row.MouseEnter:Connect(function() tw(row, 0.18, { BackgroundColor3 = Theme.Hover }) end)
		row.MouseLeave:Connect(function() tw(row, 0.18, { BackgroundColor3 = Theme.Element }) end)
	end
	return row
end

local function caption(row, text, right)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(1, -(right or 80), 1, 0), Font = Enum.Font.GothamMedium,
		Text = text, TextColor3 = Theme.Text, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	return l
end

local function createToggle(body, order, o)
	o = o or {}
	local state = o.Default == true
	local row = shell(body, order, 38, true)
	caption(row, o.Name or "Toggle", 74)

	local pill = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 38, 0, 20), BackgroundColor3 = Theme.Hover, Parent = row,
	})
	corner(pill, 10)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.new(0, 14, 0, 14), BackgroundColor3 = Theme.White, Parent = pill,
	})
	corner(knob, 7)

	local function render(anim)
		local goal = UDim2.new(0, state and 21 or 3, 0.5, 0)
		local col = state and Theme.Accent or Theme.Hover
		if anim then
			tw(knob, 0.28, { Position = goal }, Enum.EasingStyle.Back)
			tw(pill, 0.22, { BackgroundColor3 = col })
		else
			knob.Position = goal
			pill.BackgroundColor3 = col
		end
	end

	onAccent(function(c) if state then pill.BackgroundColor3 = c end end)

	local function set(v, silent)
		state = v == true
		render(true)
		if not silent and o.Callback then task.spawn(o.Callback, state) end
	end

	row.Activated:Connect(function() set(not state) end)
	render(false)
	return { Set = set, Get = function() return state end }
end

local function createSlider(body, order, o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local step = o.Step or 1
	local value = math.clamp(o.Default or min, min, max)

	local row = shell(body, order, 38, false)
	caption(row, o.Name or "Slider", 200)

	local valueLabel = new("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -148, 0.5, 0), Size = UDim2.new(0, 54, 0, 38),
		Font = Enum.Font.GothamBold, Text = "", TextColor3 = Theme.Dim, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
	})

	local track = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 122, 0, 5), BackgroundColor3 = Theme.Bg, Parent = row,
	})
	corner(track, 3)

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0, Parent = track,
	})
	corner(fill, 3)
	onAccent(function(c) fill.BackgroundColor3 = c end)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 12, 0, 12), BackgroundColor3 = Theme.White, Parent = track,
	})
	corner(knob, 6)
	local ring = stroke(knob, Theme.Accent, 2, 0)
	onAccent(function(c) ring.Color = c end)

	local function fmt(v)
		if step >= 1 then return tostring(math.floor(v + 0.5)) .. (o.Suffix or "") end
		return string.format("%.2f", v) .. (o.Suffix or "")
	end

	local function set(v, silent)
		value = math.clamp(v, min, max)
		local a = (value - min) / math.max(max - min, 1e-6)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valueLabel.Text = fmt(value)
		if not silent and o.Callback then task.spawn(o.Callback, value) end
	end

	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, Parent = row,
	})

	local dragging = false
	local function fromX(x)
		local rel = (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		rel = math.clamp(rel, 0, 1)
		local raw = min + (max - min) * rel
		if step > 0 then raw = math.floor(raw / step + 0.5) * step end
		set(raw)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tw(knob, 0.15, { Size = UDim2.new(0, 16, 0, 16) }, Enum.EasingStyle.Back)
			fromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			fromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				tw(knob, 0.15, { Size = UDim2.new(0, 12, 0, 12) }, Enum.EasingStyle.Back)
			end
		end
	end)

	set(value, true)
	return { Set = function(v) set(v) end, Get = function() return value end }
end

local function createDropdown(body, order, o)
	o = o or {}
	local items = o.Options or {}
	local selected = o.Default or items[1]
	local open = false
	local listH = #items * 28 + 8

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1,
		ClipsDescendants = true, LayoutOrder = order, Parent = body,
	})

	local header = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Element,
		Text = "", AutoButtonColor = false, Parent = holder,
	})
	corner(header, 9)
	stroke(header, Theme.Stroke, 1, 0.55)
	caption(header, o.Name or "Dropdown", 180)

	local valueLabel = new("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -36, 0.5, 0), Size = UDim2.new(0, 150, 0, 38),
		Font = Enum.Font.GothamBold, Text = "", TextColor3 = Theme.Dim, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right, Parent = header,
	})

	local chevron = new("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.new(0, 14, 0, 14),
		Font = Enum.Font.GothamBold, Text = "v", TextColor3 = Theme.Dim,
		TextSize = 12, Parent = header,
	})

	local list = new("Frame", {
		Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 0, listH),
		BackgroundColor3 = Theme.Panel, Parent = holder,
	})
	corner(list, 9)
	stroke(list, Theme.Stroke, 1, 0.4)
	pad(list, 4, 4, 4, 4)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	local entries = {}

	local function refresh()
		for _, e in ipairs(entries) do
			local sel = e.Item == selected
			e.Button.BackgroundTransparency = sel and 0 or 1
			e.Dot.BackgroundTransparency = sel and 0 or 1
			e.Label.TextColor3 = sel and Theme.Text or Theme.Dim
		end
		valueLabel.Text = tostring(selected or "-")
	end

	local function setOpen(v)
		open = v
		local target = open and (44 + listH) or 38
		tw(holder, 0.26, { Size = UDim2.new(1, 0, 0, target) }, Enum.EasingStyle.Quint)
		tw(chevron, 0.26, { Rotation = open and 180 or 0 })
	end

	for i, item in ipairs(items) do
		local opt = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Theme.Hover,
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			LayoutOrder = i, Parent = list,
		})
		corner(opt, 6)

		local dotMark = new("Frame", {
			Size = UDim2.new(0, 4, 0, 4), Position = UDim2.new(0, 10, 0.5, -2),
			BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, Parent = opt,
		})
		corner(dotMark, 2)
		onAccent(function(c) dotMark.BackgroundColor3 = c end)

		local label = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 20, 0, 0),
			Size = UDim2.new(1, -26, 1, 0), Font = Enum.Font.Gotham,
			Text = tostring(item), TextColor3 = Theme.Dim, TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left, Parent = opt,
		})

		opt.MouseEnter:Connect(function()
			if item ~= selected then opt.BackgroundTransparency = 0.5 end
		end)
		opt.MouseLeave:Connect(function()
			if item ~= selected then opt.BackgroundTransparency = 1 end
		end)
		opt.Activated:Connect(function()
			selected = item
			refresh()
			setOpen(false)
			if o.Callback then task.spawn(o.Callback, item) end
		end)

		table.insert(entries, { Item = item, Button = opt, Dot = dotMark, Label = label })
	end

	header.Activated:Connect(function() setOpen(not open) end)
	header.MouseEnter:Connect(function() tw(header, 0.18, { BackgroundColor3 = Theme.Hover }) end)
	header.MouseLeave:Connect(function() tw(header, 0.18, { BackgroundColor3 = Theme.Element }) end)

	refresh()
	return {
		Get = function() return selected end,
		Set = function(item) selected = item; refresh() end,
	}
end

local function createKeybind(body, order, o)
	o = o or {}
	local key = o.Default or Enum.KeyCode.Unknown
	local listening, conn = false, nil

	local row = shell(body, order, 38, true)
	caption(row, o.Name or "Keybind", 130)

	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 92, 0, 24), BackgroundColor3 = Theme.Hover,
		Text = "", AutoButtonColor = false, Parent = row,
	})
	corner(btn, 6)

	local btnLabel = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
		Font = Enum.Font.GothamBold, Text = "", TextColor3 = Theme.Text, TextSize = 11, Parent = btn,
	})

	local function render()
		btnLabel.Text = (key == Enum.KeyCode.Unknown) and "-" or key.Name
	end

	local function stop()
		listening = false
		if conn then conn:Disconnect(); conn = nil end
		btnLabel.TextColor3 = Theme.Text
		btn.BackgroundColor3 = Theme.Hover
		render()
	end

	local function listen()
		if listening then stop() return end
		listening = true
		btnLabel.Text = "..."
		btnLabel.TextColor3 = Theme.Accent
		btn.BackgroundColor3 = Theme.Element
		conn = UserInputService.InputBegan:Connect(function(input, processed)
			if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if input.KeyCode == Enum.KeyCode.Escape then stop() return end
			key = input.KeyCode
			stop()
			if o.Callback then task.spawn(o.Callback, key) end
		end)
	end

	row.Activated:Connect(listen)
	btn.Activated:Connect(listen)
	render()
	return { Get = function() return key end }
end

