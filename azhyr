local CARD_W, CARD_H, CARD_GAP = 296, 64, 8

local notifHolder = new("Frame", {
	Name = "Notifications",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -18, 1, -18),
	Size = UDim2.new(0, CARD_W, 0, 480),
	BackgroundTransparency = 1,
	Parent = gui,
})

local notifStack = {}

local function relayoutNotifications()
	for i = 2, #notifStack do
		tween(notifStack[i], 0.25, {
			Position = UDim2.new(1, 0, 1, -((i - 1) * (CARD_H + CARD_GAP))),
		}, Enum.EasingStyle.Quint)
	end
end

local function notify(opts)
	opts = opts or {}
	local accent = opts.Color or Theme.Accent
	local duration = opts.Duration or 4

	local card = new("CanvasGroup", {
		Name = "Card",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 340, 1, 0),
		Size = UDim2.new(0, CARD_W, 0, CARD_H),
		BackgroundColor3 = Theme.Panel,
		GroupTransparency = 1,
		Parent = notifHolder,
	})
	corner(card, 10)
	stroke(card, Theme.Stroke, 1, 0.2)

	local bar = new("Frame", {
		Size = UDim2.new(0, 3, 1, -20),
		Position = UDim2.new(0, 0, 0, 10),
		BackgroundColor3 = accent,
		Parent = card,
	})
	corner(bar, 2)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 12),
		Size = UDim2.new(1, -28, 0, 16),
		Font = Enum.Font.GothamBold,
		Text = opts.Title or "Notificação",
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 32),
		Size = UDim2.new(1, -28, 0, 22),
		Font = Enum.Font.Gotham,
		Text = opts.Text or "",
		TextColor3 = Theme.TextDim,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	})

	table.insert(notifStack, 1, card)
	relayoutNotifications()

	tween(card, 0.35, {
		Position = UDim2.new(1, 0, 1, 0),
		GroupTransparency = 0,
	}, Enum.EasingStyle.Quint)

	task.delay(duration, function()
		if not card.Parent then
			return
		end
		tween(card, 0.25, {
			Position = UDim2.new(1, 340, 1, card.Position.Y.Offset),
			GroupTransparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.26)
		local index = table.find(notifStack, card)
		if index then
			table.remove(notifStack, index)
		end
		card:Destroy()
		relayoutNotifications()
	end)

	return card
end

