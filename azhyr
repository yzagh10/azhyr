	stroke(root, Theme.Stroke, 1, 0.3)

	local top = new("Frame", {
		Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, Active = true,
		ZIndex = 3, Parent = root,
	})

	local dot = new("Frame", {
		Size = UDim2.new(0, 9, 0, 9), Position = UDim2.new(0, 18, 0, 15),
		BackgroundColor3 = Theme.Accent, Parent = top,
	})
	corner(dot, 5)
	onAccent(function(c) dot.BackgroundColor3 = c end)

	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 34, 0, 8),
		Size = UDim2.new(0, 340, 0, 18), Font = Enum.Font.GothamBold,
		Text = cfg.Title or "Aurora", TextColor3 = Theme.Text, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = top,
	})

	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 34, 0, 27),
		Size = UDim2.new(0, 340, 0, 14), Font = Enum.Font.Gotham,
		Text = cfg.Subtitle or "v2.0.0", TextColor3 = Theme.Dim, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = top,
	})

	local function topBtn(glyph, x, hover)
		local b = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, x, 0, 9),
			Size = UDim2.new(0, 30, 0, 30), BackgroundColor3 = hover,
			BackgroundTransparency = 1, Text = glyph, Font = Enum.Font.GothamBold,
			TextSize = 13, TextColor3 = Theme.Dim, AutoButtonColor = false,
			ZIndex = 4, Parent = top,
		})
		corner(b, 8)
		b.MouseEnter:Connect(function()
			tw(b, 0.15, { BackgroundTransparency = 0, TextColor3 = Theme.White })
		end)
		b.MouseLeave:Connect(function()
			tw(b, 0.15, { BackgroundTransparency = 1, TextColor3 = Theme.Dim })
		end)
		return b
	end

	local closeBtn = topBtn("x", -12, Theme.Danger)
	local minBtn = topBtn("-", -48, Theme.Element)

	local side = new("Frame", {
		Position = UDim2.new(0, 10, 0, 48), Size = UDim2.new(0, 162, 1, -58),
		BackgroundColor3 = Theme.Sidebar, ZIndex = 2, Parent = root,
	})
	corner(side, 11)

	local tabList = new("Frame", {
		Size = UDim2.new(1, -12, 1, -12), Position = UDim2.new(0, 6, 0, 6),
		BackgroundTransparency = 1, Parent = side,
	})
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabList })

	local content = new("Frame", {
		Position = UDim2.new(0, 182, 0, 48), Size = UDim2.new(1, -192, 1, -58),
		BackgroundTransparency = 1, ZIndex = 2, Parent = root,
	})

	local win = { Tabs = {}, Current = nil, Open = true, Root = root }
	local prevPage = nil

	local function selectTab(tab)
		if win.Current == tab then return end
		for _, t in ipairs(win.Tabs) do t:SetSelected(false) end
		win.Current = tab
		tab:SetSelected(true)

		if prevPage and prevPage ~= tab.Page then prevPage.Visible = false end
		prevPage = tab.Page

		tab.Page.Visible = true
		tab.Page.GroupTransparency = 1
		tab.Page.Position = UDim2.new(0, 14, 0, 0)
		tw(tab.Page, 0.3, {
			GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0),
		}, Enum.EasingStyle.Quint)
	end

	function win:CreateTab(tabCfg)
		tabCfg = tabCfg or {}
		local order = #self.Tabs + 1

		local page = new("CanvasGroup", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			Visible = false, Parent = content,
		})

		local scroll = new("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent,
			CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = page,
		})
		new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
		pad(scroll, 0, 6, 10, 0)
		onAccent(function(c) scroll.ScrollBarImageColor3 = c end)

		local button = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme.Element,
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			LayoutOrder = order, Parent = tabList,
		})
		corner(button, 9)

		local bar = new("Frame", {
			Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 0, 0.5, -8),
			BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, Parent = button,
		})
		corner(bar, 2)
		onAccent(function(c) bar.BackgroundColor3 = c end)

		local icon = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 14, 0, 0),
			Size = UDim2.new(0, 18, 1, 0), Font = Enum.Font.GothamBold,
			Text = tabCfg.Icon or "*", TextColor3 = Theme.Dim, TextSize = 13, Parent = button,
		})

		local label = new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 36, 0, 0),
			Size = UDim2.new(1, -42, 1, 0), Font = Enum.Font.GothamMedium,
			Text = tabCfg.Title or ("Tab " .. order), TextColor3 = Theme.Dim,
			TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = button,
		})

		local tab = { Page = page, Button = button }

		function tab:SetSelected(state)
			if state then
				tw(button, 0.2, { BackgroundTransparency = 0 })
				tw(bar, 0.2, { BackgroundTransparency = 0 })
				tw(label, 0.2, { TextColor3 = Theme.Text })
				icon.TextColor3 = Theme.Accent
			else
				tw(button, 0.2, { BackgroundTransparency = 1 })
				tw(bar, 0.2, { BackgroundTransparency = 1 })
				tw(label, 0.2, { TextColor3 = Theme.Dim })
				icon.TextColor3 = Theme.Dim
			end
		end

		onAccent(function(c)
			if win.Current == tab then icon.TextColor3 = c end
		end)

		button.MouseEnter:Connect(function()
			if win.Current ~= tab then tw(button, 0.18, { BackgroundTransparency = 0.55 }) end
		end)
		button.MouseLeave:Connect(function()
			if win.Current ~= tab then tw(button, 0.18, { BackgroundTransparency = 1 }) end
		end)
		button.Activated:Connect(function() selectTab(tab) end)

		local sectionCount = 0

		function tab:CreateSection(title)
			sectionCount = sectionCount + 1

			local holderFrame = new("Frame", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1, LayoutOrder = sectionCount, Parent = scroll,
			})
			new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = holderFrame })

			local head = new("Frame", {
				Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
				LayoutOrder = 1, Parent = holderFrame,
			})

			local tick = new("Frame", {
				Size = UDim2.new(0, 3, 0, 11), Position = UDim2.new(0, 0, 0.5, -5),
				BackgroundColor3 = Theme.Accent, Parent = head,
			})
			corner(tick, 2)
			onAccent(function(c) tick.BackgroundColor3 = c end)

			new("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 0),
				Size = UDim2.new(1, -10, 1, 0), Font = Enum.Font.GothamBold,
				Text = string.upper(title or "Section"), TextColor3 = Theme.Dim,
				TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
			})

			local body = new("Frame", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1, LayoutOrder = 2, Parent = holderFrame,
			})
			new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })

			local n = 0
			local function nextOrder() n = n + 1; return n end

			local s = {}
			function s:CreateToggle(o) return createToggle(body, nextOrder(), o) end
			function s:CreateSlider(o) return createSlider(body, nextOrder(), o) end
			function s:CreateDropdown(o) return createDropdown(body, nextOrder(), o) end
			function s:CreateKeybind(o) return createKeybind(body, nextOrder(), o) end
			function s:CreateTextbox(o) return createTextbox(body, nextOrder(), o) end
			function s:CreateButton(o) return createButton(body, nextOrder(), o) end
			function s:CreateLabel(o) return createLabel(body, nextOrder(), o) end
			function s:CreateColors(o) return createColors(body, nextOrder(), o) end
			return s
		end

		table.insert(self.Tabs, tab)
		if #self.Tabs == 1 then selectTab(tab) end
		return tab
	end

	function win:Notify(o) notify(o) end

	local minimized = false

	function win:SetOpen(state)
		if self.Open == state then return end
		self.Open = state
		if state then
			root.Visible, shadow.Visible = true, true
			root.GroupTransparency = 1
			root.Size = UDim2.new(0, full.X.Offset * 0.9, 0, full.Y.Offset * 0.9)
			tw(root, 0.35, { GroupTransparency = 0, Size = full }, Enum.EasingStyle.Back)
			shadow.BackgroundTransparency = 1
			tw(shadow, 0.35, { BackgroundTransparency = 0.55 })
		else
			tw(root, 0.22, { GroupTransparency = 1, Size = UDim2.new(0, full.X.Offset * 0.9, 0, full.Y.Offset * 0.9) })
			tw(shadow, 0.22, { BackgroundTransparency = 1 })
			task.delay(0.24, function()
				if not self.Open then root.Visible, shadow.Visible = false, false end
			end)
		end
	end

	function win:Toggle() self:SetOpen(not self.Open) end

	function win:SetMinimized(state)
		if minimized == state then return end
		minimized = state
		if state then
			tw(side, 0.2, { Position = UDim2.new(0, 10, 0, 48), Size = UDim2.new(0, 162, 0, 0) })
			tw(content, 0.2, { Position = UDim2.new(0, 182, 0, 48), Size = UDim2.new(1, -192, 0, 0) })
			task.delay(0.18, function()
				if minimized then side.Visible, content.Visible = false, false end
			end)
			tw(root, 0.3, { Size = UDim2.new(0, 340, 0, 48) }, Enum.EasingStyle.Quint)
			tw(shadow, 0.3, { Size = UDim2.new(0, 350, 0, 58) }, Enum.EasingStyle.Quint)
		else
			side.Visible, content.Visible = true, true
			side.Size = UDim2.new(0, 162, 1, -58)
			content.Size = UDim2.new(1, -192, 1, -58)
			tw(root, 0.3, { Size = full }, Enum.EasingStyle.Back)
			tw(shadow, 0.3, {
				Size = UDim2.new(0, full.X.Offset + 10, 0, full.Y.Offset + 10),
			}, Enum.EasingStyle.Back)
		end
	end

	local dragging, dragStart, startPos = false, nil, nil

	top.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = root.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - dragStart
			root.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
			shadow.Position = UDim2.new(
				root.Position.X.Scale, root.Position.X.Offset,
				root.Position.Y.Scale, root.Position.Y.Offset + 10
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == (cfg.ToggleKey or Enum.KeyCode.RightShift) then
			win:Toggle()
		end
	end)

	closeBtn.Activated:Connect(function() win:SetOpen(false) end)
	minBtn.Activated:Connect(function() win:SetMinimized(not minimized) end)

	shadow.BackgroundTransparency = 0.55
	tw(root, 0.45, { GroupTransparency = 0, Size = full }, Enum.EasingStyle.Back)

	return win
end

